# OpenDART 인증키 (https://opendart.fss.or.kr 무료 발급)
OPENDART_API_KEY=
# 네이버 검색 API (뉴스, 시연용) https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
